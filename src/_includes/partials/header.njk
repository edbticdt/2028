<header id="header">
  <div class="header-row">
    {%- if site.logo %}
    <a class="header-logo" href="index.html"><img src="images/{{ site.logo }}" alt="{{ site.short_name }} logo"></a>
    {%- endif %}
    <div class="header-title">
      <p class="site-name"><a href="index.html">{{ site.name }}</a></p>
      <p class="site-when">{{ site.dates }}</p>
      <p class="site-where">{{ site.city }}, {{ site.country }}</p>
    </div>
    {#- The host university's logo, or its reserved place until there is one. #}
    {%- if site.host_logo and site.host_url %}
    <a class="header-host" href="{{ site.host_url }}"><img src="images/{{ site.host_logo }}" alt="{{ site.host_name or 'Host university' }} logo"></a>
    {%- elif site.host_logo %}
    <span class="header-host"><img src="images/{{ site.host_logo }}" alt="{{ site.host_name or 'Host university' }} logo"></span>
    {%- else %}
    <span class="header-host header-host--empty" aria-hidden="true"></span>
    {%- endif %}
  </div>
  <a class="menu-link" href="#col1">Menu &darr;</a>
</header>
